import 'package:flutter/material.dart';

typedef ToggleCallback = void Function(bool isCredit);

class ToggleButton extends StatefulWidget {
  final ToggleCallback? onToggle;
  final bool initialIsCredit;
  const ToggleButton({super.key, this.onToggle, this.initialIsCredit = false});

  @override
  State<ToggleButton> createState() => _ToggleButtonState();
}

class _ToggleButtonState extends State<ToggleButton> {
  late bool isCredit;

  @override
  void initState() {
    super.initState();
    isCredit = widget.initialIsCredit;
  }

  void _toggle(bool credit) {
    setState(() {
      isCredit = credit;
    });
    if (widget.onToggle != null) {
      widget.onToggle!(isCredit);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 220,
      height: 50,
      decoration: BoxDecoration(
        border: Border.all(color: Colors.grey.shade400),
        borderRadius: BorderRadius.circular(4),
      ),
      child: Row(
        children: [
          // DEBIT BUTTON
          Expanded(
            child: GestureDetector(
              onTap: () => _toggle(false),
              child: Container(
                decoration: BoxDecoration(
                  color: !isCredit ? Colors.grey.shade700 : Colors.white,
                ),
                child: Center(
                  child: Text(
                    "DEBIT",
                    style: TextStyle(
                      color: !isCredit ? Colors.white : Colors.grey.shade700,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ),
            ),
          ),
          // CREDIT BUTTON
          Expanded(
            child: GestureDetector(
              onTap: () => _toggle(true),
              child: Container(
                decoration: BoxDecoration(
                  color: isCredit ? Colors.grey.shade700 : Colors.white,
                ),
                child: Center(
                  child: Text(
                    "CREDIT",
                    style: TextStyle(
                      color: isCredit ? Colors.white : Colors.grey.shade700,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}
